{
  "name": "mst-anchor-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "MST anchor contract: public, permanent, tamper-evident record of Fabric tx commitments",
  "license": "Apache-2.0",
  "scripts": {
    "build": "hardhat compile && npm run abi",
    "abi": "node scripts/export-abi.js",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:mst": "hardhat run scripts/deploy.ts --network mst",
    "upgrade:local": "hardhat run scripts/upgrade.ts --network localhost",
    "upgrade:mst": "hardhat run scripts/upgrade.ts --network mst"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "hardhat": "^2.28.6",
    "solc": "^0.8.28"
  }
}
